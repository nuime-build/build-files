nuimepath = envvar("NUIME_ROOT");
import $(nuimepath)/build-files/include/Nuime/NuimeBuildFiles.bkl;
ishikopath = envvar("ISHIKO_CPP_ROOT");
import $(ishikopath)/test-framework/include/Ishiko/TestFramework.bkl;

toolsets = gnu vs2022 vs2019 vs2017;

gnu.makefile = ../gnumake/GNUmakefile;
vs2022.solutionfile = ../vc17/nuime_buildfiles_tests.sln;
vs2019.solutionfile = ../vc16/nuime_buildfiles_tests.sln;
vs2017.solutionfile = ../vc15/nuime_buildfiles_tests.sln;

program nuime_buildfiles_tests : NuimeBuildFiles, IshikoTestFramework
{
    archs = x86 x86_64;

    if ($(toolset) == gnu)
    {
        cxx-compiler-options = "-std=c++11";
        libs += nuime_buildfiles IshikoUUIDs IshikoTestFrameworkCore IshikoConfiguration IshikoDiff IshikoXML IshikoFileSystem IshikoIO IshikoProcess IshikoTime IshikoText IshikoErrors IshikoBasePlatform;
        libs += yaml-cpp fmt boost_filesystem;
    }

    if ($(toolset) != gnu)
    {
        cxx-compiler-options = "/utf-8";
    }

    headers
    {
        ../../src/BakefileTestSuite.hpp
        ../../src/CMakeTestSuite.hpp
        ../../src/MSBuildTestSuite.hpp
        ../../src/NuimeTestSuite.hpp
        ../../src/VisualStudioSolutionFileTests.h
        ../../src/BakefileTestSuite/BakefilePushParserTests.hpp
        ../../src/BakefileTestSuite/BakefilePushParserTestCallbacks.hpp
        ../../src/BakefileTestSuite/BakefileTargetTests.h
        ../../src/BakefileTestSuite/BakefileTests.h
        ../../src/BakefileTestSuite/BakefileTokenizerTests.h
        ../../src/BakefileTestSuite/BakefileTokenTests.h
        ../../src/CMakeTestSuite/CMakeListsWriterTests.hpp
        ../../src/MSBuildTestSuite/MSBuildProjectFileTests.h
        ../../src/MSBuildTestSuite/MSBuildFiltersFileTests.h
        ../../src/NuimeTestSuite/NuimeBuildFileTests.hpp
        ../../src/NuimeTestSuite/NuimeInputTests.hpp
        ../../src/NuimeTestSuite/NuimeInputGroupTests.hpp
        ../../src/NuimeTestSuite/NuimeLabelTests.hpp
        ../../src/NuimeTestSuite/NuimeOutputTests.hpp
        ../../src/NuimeTestSuite/NuimeOutputGroupTests.hpp
        ../../src/NuimeTestSuite/NuimePropertyTests.hpp
        ../../src/NuimeTestSuite/NuimePropertySetTests.hpp
        ../../src/NuimeTestSuite/NuimeRecipeTests.hpp
        ../../src/NuimeTestSuite/NuimeTargetTests.hpp
    }

    sources
    {
        ../../src/BakefileTestSuite.cpp
        ../../src/CMakeTestSuite.cpp
        ../../src/main.cpp
        ../../src/MSBuildTestSuite.cpp
        ../../src/NuimeTestSuite.cpp
        ../../src/VisualStudioSolutionFileTests.cpp

        ../../src/BakefileTestSuite/BakefilePushParserTests.cpp
        ../../src/BakefileTestSuite/BakefilePushParserTestCallbacks.cpp
        ../../src/BakefileTestSuite/BakefileTargetTests.cpp
        ../../src/BakefileTestSuite/BakefileTests.cpp
        ../../src/BakefileTestSuite/BakefileTokenizerTests.cpp
        ../../src/BakefileTestSuite/BakefileTokenTests.cpp
        ../../src/CMakeTestSuite/CMakeListsWriterTests.cpp
        ../../src/MSBuildTestSuite/MSBuildProjectFileTests.cpp
        ../../src/MSBuildTestSuite/MSBuildFiltersFileTests.cpp
        ../../src/NuimeTestSuite/NuimeBuildFileTests.cpp
        ../../src/NuimeTestSuite/NuimeInputTests.cpp
        ../../src/NuimeTestSuite/NuimeInputGroupTests.cpp
        ../../src/NuimeTestSuite/NuimeLabelTests.cpp
        ../../src/NuimeTestSuite/NuimeOutputTests.cpp
        ../../src/NuimeTestSuite/NuimeOutputGroupTests.cpp
        ../../src/NuimeTestSuite/NuimePropertyTests.cpp
        ../../src/NuimeTestSuite/NuimePropertySetTests.cpp
        ../../src/NuimeTestSuite/NuimeRecipeTests.cpp
        ../../src/NuimeTestSuite/NuimeTargetTests.cpp
    }
}
