%YAML 1.2
---
nuime-version: "0.1"
name: example
targets:
  - name: lib
    input-groups:
      - inputs:
          - src/main.cpp
    output-groups:
      - outputs:
          - name: example
            filename:
              prefix: lib
              tags:
                - axis: nuime:code:configuration
                  values:
                    debug: "-d"
                    release: ""
                - axis: nuime:code:architecture
                  values:
                    x86: "-x86"
                    x64: "-x64"
