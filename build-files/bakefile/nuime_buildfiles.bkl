ishikopath = envvar("ISHIKO_CPP_ROOT");
import $(ishikopath)/errors/include/Ishiko/Errors.bkl;
import $(ishikopath)/filesystem/include/Ishiko/FileSystem.bkl;
import $(ishikopath)/io/include/Ishiko/IO.bkl;
import $(ishikopath)/text/include/Ishiko/Text.bkl;
import $(ishikopath)/third-party-glue/include/Ishiko/ThirdParty/Boost.bkl;
import $(ishikopath)/tidy-yaml/include/Ishiko/TidyYAML.bkl;
import $(ishikopath)/uuids/include/Ishiko/UUIDs.bkl;

toolsets = gnu vs2022 vs2019 vs2017;

gnu.makefile = ../gnumake/GNUmakefile;
vs2022.solutionfile = ../vc17/nuime_buildfiles.sln;
vs2019.solutionfile = ../vc16/nuime_buildfiles.sln;
vs2017.solutionfile = ../vc15/nuime_buildfiles.sln;

library nuime_buildfiles : IshikoUUIDs, IshikoTidyYAML, IshikoFileSystem, IshikoIO, IshikoText, IshikoErrors, Boost
{
    archs = x86 x86_64;

    includedirs += ../../include/Nuime/BuildFiles;

    if ($(toolset) == gnu)
    {
        cxx-compiler-options = "-std=c++14";
        outputdir = ../../lib;
    }

    if ($(toolset) != gnu)
    {
        cxx-compiler-options = "/utf-8";
        outputdir = ../../lib/$(arch);
    }

    if ($(config) == Debug)
    {
        basename = NuimeBuildFiles-d;
    }

    headers
    {
        ../../include/Nuime/BuildFiles.hpp
        ../../include/Nuime/BuildFiles/linkoptions.hpp
        ../../include/Nuime/BuildFiles/Bakefile/Bakefile.hpp
        ../../include/Nuime/BuildFiles/Bakefile/BakefilePushParser.hpp
        ../../include/Nuime/BuildFiles/Bakefile/BakefileTarget.hpp
        ../../include/Nuime/BuildFiles/Bakefile/BakefileToken.hpp
        ../../include/Nuime/BuildFiles/Bakefile/BakefileTokenizer.hpp
        ../../include/Nuime/BuildFiles/CMake/CMakeBuildFile.hpp
        ../../include/Nuime/BuildFiles/CMake/CMakeListsWriter.hpp
        ../../include/Nuime/BuildFiles/MSBuild/MSBuildProjectFile.hpp
        ../../include/Nuime/BuildFiles/MSBuild/MSBuildFiltersFile.hpp
        ../../include/Nuime/BuildFiles/Nuime/NuimeBuildFile.hpp
        ../../include/Nuime/BuildFiles/Nuime/NuimeInput.hpp
        ../../include/Nuime/BuildFiles/Nuime/NuimeInputGroup.hpp
        ../../include/Nuime/BuildFiles/Nuime/NuimeLabel.hpp
        ../../include/Nuime/BuildFiles/Nuime/NuimeWellKnownLabels.hpp
        ../../include/Nuime/BuildFiles/Nuime/NuimeOutput.hpp
        ../../include/Nuime/BuildFiles/Nuime/NuimeOutputGroup.hpp
        ../../include/Nuime/BuildFiles/Nuime/NuimeProperty.hpp
        ../../include/Nuime/BuildFiles/Nuime/NuimeRecipe.hpp
        ../../include/Nuime/BuildFiles/Nuime/NuimeTarget.hpp
        ../../include/Nuime/BuildFiles/VisualStudio/VisualStudioSolutionFile.hpp
    }

    sources
    {
        ../../src/Bakefile/Bakefile.cpp
        ../../src/Bakefile/BakefilePushParser.cpp
        ../../src/Bakefile/BakefileTarget.cpp
        ../../src/Bakefile/BakefileToken.cpp
        ../../src/Bakefile/BakefileTokenizer.cpp
        ../../src/CMake/CMakeBuildFile.cpp
        ../../src/CMake/CMakeListsWriter.cpp
        ../../src/MSBuild/MSBuildProjectFile.cpp
        ../../src/MSBuild/MSBuildFiltersFile.cpp
        ../../src/Nuime/NuimeBuildFile.cpp
        ../../src/Nuime/NuimeInput.cpp
        ../../src/Nuime/NuimeInputGroup.cpp
        ../../src/Nuime/NuimeLabel.cpp
        ../../src/Nuime/NuimeOutput.cpp
        ../../src/Nuime/NuimeOutputGroup.cpp
        ../../src/Nuime/NuimeProperty.cpp
        ../../src/Nuime/NuimeWellKnownLabels.cpp
        ../../src/Nuime/NuimeRecipe.cpp
        ../../src/Nuime/NuimeTarget.cpp
        ../../src/VisualStudio/VisualStudioSolutionFile.cpp
    }
}
